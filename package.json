{
  "name": "@escaperoomengs/ununique-design-system-web",
  "version": "1.1.0",
  "type": "module",
  "description": "Precompiled Tailwind CSS React design system with semantic tokens, brand themes, and accessible UI components.",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "ui"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EscapeRoomEngs/ununique-design-system-web.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode library && tsc --project tsconfig.build.json",
    "build:demo": "vite build --outDir demo-dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:package": "npm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run typecheck:storybook && npm run build && node scripts/test-package.mjs",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "typecheck:storybook": "tsc --project tsconfig.storybook.json",
    "build-storybook": "npm run typecheck:storybook && storybook build",
    "chromatic": "npx chromatic --project-token=chpt_5b7834704b08147"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "chromatic": "^18.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.5",
    "globals": "^17.9.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
